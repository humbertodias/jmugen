<?xml version="1.0" encoding="UTF-8"?>
<!--
  Browser-only engine pieces for LibGDX web.
  - gwt/ super-source: FQN overrides of JVM / alternate-root classes
  - Gwt* types under org/lee/mugen/** (this Maven module)
-->
<module>
    <inherits name="org.lee.mugen.JMugenCommon"/>
    <inherits name="org.lee.mugen.JMugenProperties"/>

    <super-source path="gwt"/>

    <source path="core">
        <include name="GwtGameFight.java"/>
    </source>
    <source path="fight">
        <include name="GwtFightHud.java"/>
        <include name="GwtFightHudParser.java"/>
        <include name="GwtFightSprRoot.java"/>
        <include name="GwtFightFighterAnim.java"/>
        <include name="GwtFightPlayer.java"/>
        <include name="GwtFightCmdProcess.java"/>
        <include name="GwtCmdLoader.java"/>
        <include name="GwtCnsData.java"/>
        <include name="GwtCnsLoader.java"/>
        <include name="GwtCnsRuntime.java"/>
        <include name="GwtStageFightInfo.java"/>
        <include name="GwtFightRules.java"/>
        <include name="GwtFightAudio.java"/>
        <include name="GwtFightHitbox.java"/>
        <include name="GwtFightPush.java"/>
    </source>
    <source path="core/gameSelect">
        <include name="GwtGameSelect.java"/>
        <include name="GwtGameVsScreen.java"/>
        <include name="GwtSelectionController.java"/>
    </source>
    <source path="fight/select">
        <include name="GwtSelect.java"/>
        <include name="GwtCharacters.java"/>
        <include name="GwtExtraStages.java"/>
    </source>
    <source path="core/renderer/game">
        <include name="GwtStageBackgroundRender.java"/>
    </source>
    <source path="core/renderer/game/vsScreen">
        <include name="GwtVsScreenRender.java"/>
    </source>
    <source path="core/renderer/game/select">
        <include name="GwtSelectRender.java"/>
    </source>
    <source path="fight/system/elem">
        <include name="GwtPlayerVsScreen.java"/>
    </source>
    <source path="background">
        <include name="GwtStageRoot.java"/>
        <include name="GwtStageSelectBackground.java"/>
    </source>
</module>
