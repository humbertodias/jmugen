<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>JMugen.Render.libgdx.web</groupId>
    <artifactId>JMugen.Render.libgdx.web</artifactId>

    <parent>
        <groupId>JMugen.Parent</groupId>
        <artifactId>JMugen.Parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <properties>
        <libgdx.version>1.14.0</libgdx.version>
        <mugen.data.source>${project.basedir}/../data</mugen.data.source>
        <gdx.assets.dir>${project.build.directory}/gdx-assets</gdx.assets.dir>
        <!-- gwt:run — embedded server (index.html); override: -Dgwt.port=… -->
        <gwt.port>8888</gwt.port>
        <!-- Code server UI; plugin default 9997; override: -Dgwt.codeServerPort=… -->
        <gwt.codeServerPort>9876</gwt.codeServerPort>
        <!-- Optional JVM flags; append JDWP here for DevMode remote debug if needed (Java 8: use address=127.0.0.1:port, not *:port). -->
        <gwt.jvm.debug.args></gwt.jvm.debug.args>
    </properties>

    <dependencies>
        <dependency>
            <groupId>JMugen</groupId>
            <artifactId>JMugen</artifactId>
            <version>${jmugen.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>JMugen.plugin.audio.adx</groupId>
                    <artifactId>JMugen.plugin.audio.adx</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.googlecode.soundlibs</groupId>
                    <artifactId>mp3spi</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.googlecode.soundlibs</groupId>
                    <artifactId>vorbisspi</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.googlecode.soundlibs</groupId>
                    <artifactId>tritonus-share</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>JMugen.Properties</groupId>
            <artifactId>JMugen.Properties</artifactId>
            <version>${jmugen.version}</version>
        </dependency>
        <dependency>
            <groupId>JMugen.Render.libgdx.core</groupId>
            <artifactId>JMugen.Render.libgdx.core</artifactId>
            <version>${jmugen.version}</version>
        </dependency>
        <dependency>
            <groupId>JMugen</groupId>
            <artifactId>JMugen</artifactId>
            <version>${jmugen.version}</version>
            <classifier>sources</classifier>
        </dependency>
        <dependency>
            <groupId>JMugen.Properties</groupId>
            <artifactId>JMugen.Properties</artifactId>
            <version>${jmugen.version}</version>
            <classifier>sources</classifier>
        </dependency>
        <dependency>
            <groupId>JMugen.Common</groupId>
            <artifactId>JMugen.Common</artifactId>
            <version>${jmugen.version}</version>
            <classifier>sources</classifier>
        </dependency>
        <dependency>
            <groupId>JMugen.Render.libgdx.core</groupId>
            <artifactId>JMugen.Render.libgdx.core</artifactId>
            <version>${jmugen.version}</version>
            <classifier>sources</classifier>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-backend-gwt</artifactId>
            <version>${libgdx.version}</version>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx</artifactId>
            <version>${libgdx.version}</version>
            <classifier>sources</classifier>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-backend-gwt</artifactId>
            <version>${libgdx.version}</version>
            <classifier>sources</classifier>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Super-source only for GWT; same FQN as JVM types. -->
                        <exclude>**/gwt/**</exclude>
                        <!-- Web engine types; compiled by GWT against super-source, not javac. -->
                        <exclude>**/Gwt*.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>stage-mugen-data-into-gdx-assets</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${gdx.assets.dir}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${mugen.data.source}</directory>
                                    <targetPath>data</targetPath>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>gwt-maven-plugin</artifactId>
                <version>${gwt.version}</version>
                <configuration>
                    <module>org.lee.mugen.renderer.libgdx.web.JMugenWeb</module>
                    <modules>
                        <module>org.lee.mugen.renderer.libgdx.web.JMugenWeb</module>
                    </modules>
                    <runTarget>index.html</runTarget>
                    <!-- Same tree as gwt:compile webappDirectory; plugin copies target/classes → WEB-INF/classes here. -->
                    <hostedWebapp>${project.build.directory}/webapp</hostedWebapp>
                    <webappDirectory>${project.build.directory}/webapp</webappDirectory>
                    <copyWebapp>true</copyWebapp>
                    <port>${gwt.port}</port>
                    <codeServerPort>${gwt.codeServerPort}</codeServerPort>
                    <!-- Client runs as JS in the browser; PRETTY helps Chrome DevTools. JDWP only hits Java in this JVM. -->
                    <style>PRETTY</style>
                    <extraJvmArgs>-Xmx1024m ${gwt.jvm.debug.args}</extraJvmArgs>
                    <compileSourcesArtifacts>
                        <artifact>JMugen:JMugen</artifact>
                        <artifact>JMugen.Common:JMugen.Common</artifact>
                        <artifact>JMugen.Properties:JMugen.Properties</artifact>
                    </compileSourcesArtifacts>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
