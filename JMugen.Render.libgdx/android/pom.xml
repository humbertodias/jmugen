<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>JMugen.Render.libgdx.android</groupId>
    <artifactId>JMugen.Render.libgdx.android</artifactId>
    <packaging>apk</packaging>

    <parent>
        <groupId>JMugen.Render.libgdx</groupId>
        <artifactId>JMugen.Render.libgdx</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <properties>
        <libgdx.version>1.14.2</libgdx.version>
        <android.maven.plugin.version>4.6.0</android.maven.plugin.version>
        <android.compile.sdk>34</android.compile.sdk>
        <gdx.backend.unpack.dir>${project.build.directory}/unpacked-libs/cbg_gdx-backend-android_${libgdx.version}</gdx.backend.unpack.dir>
        <!-- Repo layout: data/ at repository root (two levels up from android/). -->
        <mugen.data.source>${project.basedir}/../../data</mugen.data.source>
        <android.assets.dir>${project.basedir}/src/main/assets</android.assets.dir>
    </properties>

    <repositories>
        <repository>
            <id>google-maven-android</id>
            <url>https://dl.google.com/dl/android/maven2/</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>JMugen.Render.libgdx.core</groupId>
            <artifactId>JMugen.Render.libgdx.core</artifactId>
            <version>${jmugen.version}</version>
        </dependency>
        <dependency>
            <groupId>JMugen</groupId>
            <artifactId>JMugen</artifactId>
            <version>${jmugen.version}</version>
            <exclusions>
                <!-- mp3spi pulls soundlibs jlayer; vorbisspi pulls javazoom jlayer — same javazoom.jl.* types, D8 duplicate. -->
                <exclusion>
                    <groupId>javazoom</groupId>
                    <artifactId>jlayer</artifactId>
                </exclusion>
                <!-- vorbisspi and mp3spi both ship javazoom.spi.PropertiesContainer; keep mp3 only for dex. -->
                <exclusion>
                    <groupId>com.googlecode.soundlibs</groupId>
                    <artifactId>vorbisspi</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- AAR for resources/dex; unpacked classes.jar is on javac classpath. Transitive androidx.core is
             declared without <type>aar</type> in LibGDX's POM, so Maven resolves a non-existent :jar from Central.
             Exclude it here and pull androidx.core explicitly as AAR from Google's Maven repo. -->
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-backend-android</artifactId>
            <version>${libgdx.version}</version>
            <type>aar</type>
            <exclusions>
                <exclusion>
                    <groupId>androidx.core</groupId>
                    <artifactId>core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>androidx.core</groupId>
            <artifactId>core</artifactId>
            <version>1.10.0</version>
            <type>aar</type>
            <exclusions>
                <!-- core's POM requests lifecycle-runtime without <type>aar</type>; Google Maven has no .jar. -->
                <exclusion>
                    <groupId>androidx.lifecycle</groupId>
                    <artifactId>lifecycle-runtime</artifactId>
                </exclusion>
                <!-- D8Mojo passes each dependency both as classpath and as an input file; D8 28 errors on
                     androidx.interpolator when listed twice. Core does not need interpolator for LibGDX. -->
                <exclusion>
                    <groupId>androidx.interpolator</groupId>
                    <artifactId>interpolator</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>androidx.lifecycle</groupId>
            <artifactId>lifecycle-runtime</artifactId>
            <version>2.2.0</version>
            <type>aar</type>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-platform</artifactId>
            <version>${libgdx.version}</version>
            <classifier>natives-arm64-v8a</classifier>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-freetype-platform</artifactId>
            <version>${libgdx.version}</version>
            <classifier>natives-arm64-v8a</classifier>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.android</groupId>
            <artifactId>android</artifactId>
            <version>4.1.1.4</version>
            <scope>provided</scope>
        </dependency>
        <!-- Pin Apache Commons for dx 30 (no multi-release / module-info in classpath). -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.8.0</version>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <!-- LibGDX natives ship as jars (classifier natives-*); android-maven-plugin only packs type "so" or AAR jni/libs. -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>stage-mugen-data-into-android-assets</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${android.assets.dir}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${mugen.data.source}</directory>
                                    <targetPath>data</targetPath>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>unpack-gdx-natives</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.badlogicgames.gdx</groupId>
                                    <artifactId>gdx-platform</artifactId>
                                    <version>${libgdx.version}</version>
                                    <classifier>natives-arm64-v8a</classifier>
                                    <type>jar</type>
                                    <outputDirectory>${project.build.directory}/jni-libs/arm64-v8a</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.badlogicgames.gdx</groupId>
                                    <artifactId>gdx-freetype-platform</artifactId>
                                    <version>${libgdx.version}</version>
                                    <classifier>natives-arm64-v8a</classifier>
                                    <type>jar</type>
                                    <outputDirectory>${project.build.directory}/jni-libs/arm64-v8a</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <configuration combine.children="append">
                            <additionalClasspathElements combine.children="append">
                                <additionalClasspathElement>${gdx.backend.unpack.dir}/classes.jar</additionalClasspathElement>
                            </additionalClasspathElements>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration combine.children="append">
                            <additionalClasspathElements combine.children="append">
                                <additionalClasspathElement>${gdx.backend.unpack.dir}/classes.jar</additionalClasspathElement>
                            </additionalClasspathElements>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.simpligility.maven.plugins</groupId>
                <artifactId>android-maven-plugin</artifactId>
                <version>${android.maven.plugin.version}</version>
                <extensions>true</extensions>
                <!-- Do NOT bind default-d8 to phase none: when dexCompiler is d8, DexMojo skips dexing and
                     D8Mojo must run (prepare-package). Otherwise an old classes.dex from a prior dx build can be repackaged. -->
                <configuration>
                    <!-- LibGDX 1.14+ uses invokedynamic in ArraySupplier; D8 with low min-api desugars library lambdas. -->
                    <dexCompiler>d8</dexCompiler>
                    <d8MinApi>24</d8MinApi>
                    <sdk>
                        <platform>${android.compile.sdk}</platform>
                        <!-- build-tools 30+ ships d8.jar without Main-Class; android-maven-plugin runs `java -jar d8.jar`.
                             28.0.3 provides an executable-fat d8.jar so D8Mojo works and can desugar LibGDX lambdas. -->
                        <buildTools>28.0.3</buildTools>
                    </sdk>
                    <sign>
                        <debug>true</debug>
                    </sign>
                    <nativeLibrariesDirectory>${project.build.directory}/jni-libs</nativeLibrariesDirectory>
                    <assetsDirectory>${android.assets.dir}</assetsDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
