<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>JMugen.Render.libgdx.desktop</groupId>
    <artifactId>JMugen.Render.libgdx.desktop</artifactId>

    <parent>
        <groupId>JMugen.Parent</groupId>
        <artifactId>JMugen.Parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <properties>
        <libgdx.version>1.14.0</libgdx.version>
        <desktop.mainClass>org.lee.mugen.renderer.libgdx.LGDXDesktopMain</desktop.mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>JMugen</groupId>
            <artifactId>JMugen</artifactId>
            <version>${jmugen.version}</version>
        </dependency>
        <dependency>
            <groupId>JMugen.Render.libgdx.core</groupId>
            <artifactId>JMugen.Render.libgdx.core</artifactId>
            <version>${jmugen.version}</version>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-backend-lwjgl3</artifactId>
            <version>${libgdx.version}</version>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-platform</artifactId>
            <version>${libgdx.version}</version>
            <classifier>natives-desktop</classifier>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-freetype-platform</artifactId>
            <version>${libgdx.version}</version>
            <classifier>natives-desktop</classifier>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Prefer exec:exec (forked JVM). exec:java reuses the Maven JVM, so
              -XstartOnFirstThread cannot apply on macOS and GLFW fails.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <executable>java</executable>
                    <workingDirectory>${session.executionRootDirectory}</workingDirectory>
                    <arguments>
                        <argument>-cp</argument>
                        <classpath/>
                        <argument>${desktop.mainClass}</argument>
                    </arguments>
                    <mainClass>${desktop.mainClass}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>macos-lwjgl</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <configuration>
                            <executable>java</executable>
                            <workingDirectory>${session.executionRootDirectory}</workingDirectory>
                            <arguments>
                                <argument>-XstartOnFirstThread</argument>
                                <argument>-cp</argument>
                                <classpath/>
                                <argument>${desktop.mainClass}</argument>
                            </arguments>
                            <mainClass>${desktop.mainClass}</mainClass>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
