<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>JMugen.Debug</groupId>
  <artifactId>JMugen.Debug</artifactId>

  <parent>
    <groupId>JMugen.tools</groupId>
    <artifactId>JMugen.tools</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <dependencies>

    <dependency>
      <groupId>JMugen</groupId>
      <artifactId>JMugen</artifactId>
      <version>${jmugen.version}</version>
    </dependency>

    <dependency>
      <groupId>JMugen.Common</groupId>
      <artifactId>JMugen.Common</artifactId>
      <version>${jmugen.version}</version>
    </dependency>

    <dependency>
      <groupId>JMugen.Properties</groupId>
      <artifactId>JMugen.Properties</artifactId>
      <version>${jmugen.version}</version>
    </dependency>

    <dependency>
      <groupId>Syntax</groupId>
      <artifactId>Syntax</artifactId>
      <version>${jmugen.version}</version>
    </dependency>

    <dependency>
      <groupId>JMugen.Render.libgdx.desktop</groupId>
      <artifactId>JMugen.Render.libgdx.desktop</artifactId>
      <version>${jmugen.version}</version>
    </dependency>
    
  </dependencies>

  <build>

    <plugins>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <configuration>
          <createDependencyReducedPom>false</createDependencyReducedPom>
          <filters>
            <filter>
              <artifact>*:*</artifact>
              <excludes>
                <exclude>META-INF/*.SF</exclude>
                <exclude>META-INF/*.DSA</exclude>
                <exclude>META-INF/*.RSA</exclude>
              </excludes>
            </filter>
          </filters>
          <transformers>
            <transformer
                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
              <mainClass>${main.class}</mainClass>
            </transformer>
          </transformers>
        </configuration>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

    </plugins>

  </build>
</project>
