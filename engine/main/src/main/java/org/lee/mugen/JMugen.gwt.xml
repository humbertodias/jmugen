<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared GWT-translatable engine sources (no browser-only Gwt* / super-source).
  Web entry inherits org.lee.mugen.JMugenWebClient for overrides + Gwt* implementations.
-->
<module>
    <inherits name="org.lee.mugen.JMugenCommon"/>
    <inherits name="org.lee.mugen.JMugenProperties"/>

    <source path="core">
        <include name="GameMenu.java"/>
    </source>
    <source path="core/renderer/game/system">
        <include name="TitleInfoRender.java"/>
        <include name="BackgroundRender.java"/>
    </source>
    <source path="core/renderer/game/fight">
        <include name="BaseRender.java"/>
    </source>
    <source path="fight/section/elem">
        <include name="FontType.java"/>
        <include name="SprType.java"/>
    </source>
    <source path="fight/system">
        <include name="TitleInfo.java"/>
        <include name="Music.java"/>
        <include name="Info.java"/>
    </source>
    <source path="fight/system/elem">
        <include name="Menu.java"/>
        <include name="ItemName.java"/>
        <include name="Item.java"/>
        <include name="Value.java"/>
        <include name="Cell.java"/>
        <include name="PlayerSelectInfo.java"/>
        <include name="PlayerCursor.java"/>
        <include name="Stage.java"/>
        <include name="StageDisplay.java"/>
    </source>
    <source path="background">
        <include name="Background.java"/>
        <include name="BG.java"/>
        <include name="BGdef.java"/>
        <include name="BGCtrlDef.java"/>
        <include name="GwtBackground.java"/>
        <include name="BgExpression.java"/>
    </source>
    <source path="fight/section">
        <include name="Section.java"/>
    </source>
    <source path="fight/section/elem">
        <include name="Type.java"/>
        <include name="CommonType.java"/>
        <include name="SndType.java"/>
    </source>
    <source path="fight/intro/entity">
        <include name="Fade.java"/>
    </source>
    <source path="sprite/parser">
        <include name="Parser.java"/>
    </source>
    <source path="sprite/common/resource">
        <include name="FontParser.java"/>
        <include name="FontProducer.java"/>
        <include name="Desc.java"/>
    </source>
    <source path="sprite/base">
        <include name="AbstractAnimManager.java"/>
    </source>
    <source path="sprite/baseForParse">
        <include name="SpriteSFF.java"/>
        <include name="ImageSpriteSFF.java"/>
        <include name="GroupSpriteSFF.java"/>
    </source>
    <source path="sprite/character">
        <include name="AnimGroup.java"/>
        <include name="AnimElement.java"/>
    </source>
    <source path="sff">
        <include name="**/*.java"/>
    </source>
    <source path="snd">
        <include name="**/*.java"/>
    </source>
    <source path="parser/air">
        <include name="**/*.java"/>
    </source>

    <source path="">
        <exclude name="sprite/character/Sprite.java"/>
        <exclude name="sprite/character/SpriteCns.java"/>
        <exclude name="sprite/character/SpriteDef.java"/>
        <exclude name="sprite/character/SpriteHelper.java"/>
